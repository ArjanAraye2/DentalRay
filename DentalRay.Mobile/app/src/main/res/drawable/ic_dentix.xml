<?xml version="1.0" encoding="utf-8"?>
<!--
  Dentix launcher icon.

  Same tooth as the desktop app (path copied from toothSvg() in login-ui.js)
  on a white rounded tile, with the version badge at the bottom so the
  installed build is readable at a glance.

  The badge PNG is generated by tools/Set-VersionBadge.ps1 - run it after
  changing versionName in app/build.gradle.kts.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- زمینه -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- دندان، همان مسیر لوگوی دنتیکس روی کامپیوتر -->
    <item
        android:width="56dp"
        android:height="66dp"
        android:gravity="center">
        <vector xmlns:android="http://schemas.android.com/apk/res/android"
            android:width="56dp"
            android:height="66dp"
            android:viewportWidth="48"
            android:viewportHeight="56">
            <path
                android:pathData="M13.3,4.8C8.2,5.7 4.9,10 5.4,15.1c0.4,4.4 3,7.3 4.8,10.8c1.9,3.6 1.9,10.6 2.9,16.5c0.6,3.7 2,6.2 4.7,6.2c3.3,0 3.9,-5.2 4.4,-9.6c0.5,-4.2 1.2,-7.1 2.8,-7.1s2.3,2.9 2.8,7.1c0.5,4.4 1.1,9.6 4.4,9.6c2.7,0 4.1,-2.5 4.7,-6.2c1,-5.9 1,-12.9 2.9,-16.5c1.8,-3.5 4.4,-6.4 4.8,-10.8c0.5,-5.1 -2.8,-9.4 -7.9,-10.3c-3.5,-0.6 -6.2,0.8 -8.1,2.2c-1.4,1 -2.5,1 -3.9,0c-1.9,-1.4 -4.6,-2.8 -8.1,-2.2Z"
                android:fillColor="#FFFFFF"
                android:strokeColor="#159BB6"
                android:strokeWidth="2.6" />
        </vector>
    </item>

    <!-- نشان نسخه -->
    <item
        android:width="46dp"
        android:height="17dp"
        android:gravity="bottom|center_horizontal"
        android:bottom="8dp">
        <bitmap android:src="@drawable/ic_version_badge" />
    </item>
</layer-list>
